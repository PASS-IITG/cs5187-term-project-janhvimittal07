{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hint",
  "type": "object",
  "required": [
    "file",
    "line",
    "kind",
    "context"
  ],
  "properties": {
    "file": {
      "type": "string",
      "description": "path relative to the DuckDB source root"
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "magic_const",
        "branch",
        "sink",
        "assert"
      ]
    },
    "value": {
      "type": "string",
      "description": "constant or boundary, e.g. '2048'"
    },
    "function": {
      "type": "string"
    },
    "context": {
      "type": "string",
      "description": "about 5 lines of source around the hint"
    }
  }
}
